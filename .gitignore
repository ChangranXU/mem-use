# Secrets
.env

# Python bytecode
__pycache__/
*.py[cod]

# Test and lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# Packaging artifacts
*.egg-info/
build/
dist/

# Editor directories
.cursor/

# OS files
.DS_Store

# Eval outputs
output/

# Benchmark data artifacts — regenerable via data/utils/build_data.py, but
# version-controlled: verify_data.py's frozen anchors pin these bytes, and
# frozen counters over untracked artifacts are unenforceable. Secrets and
# caches (.env, .DS_Store, __pycache__) stay ignored by the global rules.
data/*
!data/README.md
!data/transfer-map.json
!data/verified-metadata.json
!data/instance-ids-*.txt
!data/repo-neighbor-*
!data/repo-interference
!data/repo-core-*
!data/utils
