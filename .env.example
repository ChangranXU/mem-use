# Judge agent configuration for `uv run -m injudge`.
# Copy to .env and fill in. All keys are optional unless marked required.
# Quotes are stripped; a trailing "# ..." comment after a value is ignored.

# Judge model name (required; --judge-model overrides)
MODEL="deepseek-v4-flash"

# API key for the judge endpoint (required; sent only to BASE_URL)
API_KEY="sk-xxxxxxxxxxxx"

# Judge endpoint base URL (required)
# API=openai-chat: any OpenAI-compatible chat endpoint; BASE_URL points at
# the root carrying /chat/completions (e.g. https://api.deepseek.com).
# API=anthropic: BASE_URL at the API host root (e.g. https://api.anthropic.com).
BASE_URL="https://api.deepseek.com"

# Aliases: when set, these shadow BASE_URL / API_KEY
# OPENAI_BASE_URL="https://api.deepseek.com"
# OPENAI_API_KEY="sk-xxxxxxxxxxxx"

# Wire format: openai-chat (default) | anthropic
# API="openai-chat"

# -------------------------------------------------- the agent's two budgets
# Initial investigation's LLM-call cap, forced final round included
# (default 40). A resumed investigation gets min(MAX_STEPS, 4) calls;
# repair gets one. Exhausting an investigation budget forces a final answer.
# MAX_STEPS="40"

# The judge model's context window in tokens (default 131072). The
# watermark reserves MAX_OUTPUT_TOKENS and the forced message estimate;
# both together must leave room for input before any trajectory is loaded.
# CONTEXT_WINDOW="131072"

# Max output tokens per LLM call (default 32768). The context watermark
# reserves this space for output, leaving less room for input evidence;
# billing is on tokens actually generated. A verdict cut mid-answer takes
# the corrective retry, never a silent misjudgment.
# --judge-max-tokens overrides.
# MAX_OUTPUT_TOKENS="32768"

# ------------------------------------------------------- sampling / retries
# Sampling temperature (default 0.0)
# TEMPERATURE="0.0"

# Thinking level passed to the agent: off (default) | minimal | low |
# medium | high | xhigh | max
# THINKING_LEVEL="off"

# Total runner phases per span: investigation, one-call repair, and any
# investigation resumed for explicitly requested missing evidence (default 5).
# An invalid repair stops; it is not blindly retried. --max-attempts overrides.
# MAX_ATTEMPTS="5"

# Per-LLM-call timeout seconds (default 300). --timeout overrides.
# TIMEOUT="300"

# ------------------------------------------------------------ concurrency
# Span-level concurrency: this many spans of one trajectory are judged in
# parallel (default 1 = serial, cap 32) — each running its own agent
# JUDGE_PARALLEL="1"
