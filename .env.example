# Judge endpoint configuration for `uv run -m injudge`.
# Copy to .env and fill in. All keys are optional unless marked required.
# Quotes are stripped; a trailing "# ..." comment after a value is ignored.

# Judge model name (required; --judge-model overrides)
MODEL="deepseek-v4-flash"

# API key for the judge endpoint (required)
API_KEY="sk-xxxxxxxxxxxx"

# Wire format: openai-chat (default) | responses | anthropic
API="openai-chat"

# Judge endpoint base URL (required)
BASE_URL="https://api.deepseek.com"

# Aliases: when set, these shadow BASE_URL / API_KEY
# OPENAI_BASE_URL="https://api.deepseek.com"
# OPENAI_API_KEY="sk-xxxxxxxxxxxx"

# Thinking mode switch: enabled | disabled (unset = provider default;
# DeepSeek defaults to enabled with effort high)
# THINKING="enabled"

# Thinking effort (provider-native pass-through):
# none | minimal | low | medium | high | xhigh | max
# openai-chat -> reasoning_effort; responses -> reasoning.effort;
# anthropic -> output_config.effort
# THINKING_EFFORT="high"

# Anthropic only: thinking budget in tokens, required when
# API="anthropic" and THINKING="enabled" (must be < --judge-max-tokens)
# THINKING_BUDGET="8192"

# Sampling temperature (default 0.0)
# TEMPERATURE="0.0"

# Judge response budget in output tokens (default 65536; respect the endpoint's
# output ceiling and leave room for this within its total context window). Reasoning models burn
# most of it on reasoning; a verdict cut mid-answer fails the span as an
# error, never a silent misjudgment, so keep headroom. A cap, not a
# reservation: billing is on tokens actually generated. --judge-max-tokens
# overrides.
# MAX_TOKENS="65536"

# Total generation tries per judged span at the working conformance tier —
# transport failures and out-of-contract answers share the budget;
# discovering the working tier (a 400/422 rejection or an ignored format
# field) is free (default 5)
# MAX_ATTEMPTS="5"

# Pin the output-conformance tier: structured | json | prompt.
# Unset = auto chain from structured: a format-field rejection (400/422) or
# out-of-contract output degrades one tier, and the working tier is memoized
# for the rest of the run. A 400/422 repeating unchanged at the final
# (format-less) tier — no answered request in between — is a config fault,
# not a format refusal, and fails the span; the repeat is judged only at
# that tier because a gateway rejecting every format field with one generic
# error body repeats it across the format tiers too. Any other non-429 4xx
# (auth, unknown URL, payload too large) fails the span at once. Anthropic
# has no json tier.
# Pinned: the tier cannot degrade, so a request rejection (400/422) fails
# the span with an error verdict (recorded, run continues) instead of
# stopping the run.
# OUTPUT_FORMAT="structured"

# ------------------------------------------------------- long-input strategy
# Span-level concurrency: this many spans of one trajectory are judged in
# parallel (default 1 = serial, cap 32). Each in-flight span may itself run
# SCAN_PARALLEL extraction calls on the scan path — worst-case concurrent
# calls reach JUDGE_PARALLEL x SCAN_PARALLEL
# JUDGE_PARALLEL="1"

# Token cap for the scoring request body (the scoring system prompt + the
# final scoring user, gold blocks included), estimated with tiktoken
# o200k_base. Below the cap: one full-text scoring call per span. Above: a
# chunked evidence-extraction scan of the whole trajectory feeds the same
# scoring call (never truncated to fit). Default 800000: leave headroom
# within a 1M-token context for output, wire/schema overhead and tokenizer
# differences. Lower this for smaller endpoints. There are no independent
# placement/query previews or step-stream cuts before this gate.
# JUDGE_INPUT_TOKENS="800000"

# Concurrent extraction calls (default 4, cap 32; 1 = fully serial).
# Constrains extraction only; scoring is always one call.
# SCAN_PARALLEL="4"

# Optional max agent steps per extraction chunk (default 0 = no step cap).
# Token-sized chunks preserve longer action/result sequences.
# SCAN_CHUNK_STEPS="0"

# Token cap for one extraction-request user body (default: half of
# JUDGE_INPUT_TOKENS, no fixed ceiling; a set value must be smaller than
# JUDGE_INPUT_TOKENS). Size explicitly for a smaller extraction endpoint.
# A single oversized step still enters extraction in full, never clipped.
# SCAN_CHUNK_TOKENS="400000"

# Verbatim steps kept on each side of the injection step in the scoring
# input (default 2; 0 = only the injection step itself)
# SCAN_NEIGHBORHOOD="2"

# Extracted evidence has no separate per-chunk limit. Only an over-budget
# assembled scoring input earns one evidence-compression pass; failure
# retains the original and marks over_budget, never silently clips it.

# ----------------------------- optional extraction (scan) endpoint overrides
# Extraction runs on a COPY of the scoring config with these applied; unset
# inherits the scoring value, except SCAN_THINKING which defaults to
# disabled (an evidence list needs no reasoning budget). Aliases
# SCAN_OPENAI_BASE_URL / SCAN_OPENAI_API_KEY shadow SCAN_BASE_URL /
# SCAN_API_KEY (same rule as the scoring aliases). Setting companion keys
# without SCAN_MODEL is legal.
# SCAN_MODEL="deepseek-v4-flash"
# SCAN_API="openai-chat"          # openai-chat | responses | anthropic
# SCAN_BASE_URL="https://api.deepseek.com"
# SCAN_API_KEY="sk-xxxxxxxxxxxx"
# SCAN_THINKING="disabled"        # enabled | disabled
# SCAN_MAX_TOKENS="65536"           # unset inherits the scoring MAX_TOKENS
# SCAN_TEMPERATURE="0.0"
# SCAN_MAX_ATTEMPTS="5"
# SCAN_THINKING_EFFORT="low"
# SCAN_THINKING_BUDGET="8192"     # required when SCAN_API=anthropic with SCAN_THINKING=enabled
# SCAN_OUTPUT_FORMAT="structured" # structured | json | prompt (the JSON is EXTRACTION_SCHEMA)
