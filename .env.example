# Judge endpoint configuration for `python3 -m eval.injudge`.
# Copy to eval/.env and fill in. All keys are optional unless marked required.
# Quotes are stripped; a trailing "# ..." comment after a value is ignored.

# Judge model name (required; --judge-model overrides)
MODEL="deepseek-v4-flash"

# API key for the judge endpoint (required)
API_KEY="sk-xxxxxxxxxxxx"

# Wire format: openai-chat (default) | responses | anthropic
API="openai-chat"

# Judge endpoint base URL (required)
BASE_URL="https://api.deepseek.com"

# Aliases: when set, these shadow BASE_URL / API_KEY
# OPENAI_BASE_URL="https://api.deepseek.com"
# OPENAI_API_KEY="sk-xxxxxxxxxxxx"

# Thinking mode switch: enabled | disabled (unset = provider default;
# DeepSeek defaults to enabled with effort high)
# THINKING="enabled"

# Thinking effort (provider-native pass-through):
# none | minimal | low | medium | high | xhigh | max
# openai-chat -> reasoning_effort; responses -> reasoning.effort;
# anthropic -> output_config.effort
# THINKING_EFFORT="high"

# Anthropic only: thinking budget in tokens, required when
# API="anthropic" and THINKING="enabled" (must be < --judge-max-tokens)
# THINKING_BUDGET="8192"

# Sampling temperature (default 0.0)
# TEMPERATURE="0.0"

# Total generation tries per judged span at the working conformance tier —
# transport failures and out-of-contract answers share the budget;
# discovering the working tier (a 400/422 rejection or an ignored format
# field) is free (default 5)
# MAX_ATTEMPTS="5"

# Pin the output-conformance tier: structured | json | prompt.
# Unset = auto chain from structured: a format-field rejection (400/422) or
# out-of-contract output degrades one tier, and the working tier is memoized
# for the rest of the run; a 400/422 repeating unchanged after the format
# field changed is a config fault, not a format rejection, and fails the
# span fast — as does any other non-429 4xx (auth, unknown URL, payload too
# large). Anthropic has no json tier.
# Pinned: the tier cannot degrade, so a request rejection (400/422) fails
# the span with an error verdict (recorded, run continues) instead of
# stopping the run.
# OUTPUT_FORMAT="structured"
